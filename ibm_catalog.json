            "short_description": "FortiGate delivers top-rated cloud security with NGFW protection, VPN, SD-WAN, and High Availability support across zones, available through and supported by IBM.",
            "long_description": "Fortinet FortiGate Next Generation Firewall (NGFW), available through and supported by IBM, provides highly available network security across cloud availability zones. FortiGate helps protect cloud environments with comprehensive network security, VPN connectivity, SD-WAN, intrusion prevention, Web filtering, and application-aware security while supporting resilient, cross-zone deployments. FortiGate NGFW integrates with AI-driven FortiGuard and FortiSandbox services to help protect against known and zero-day threats. For centralized security management and analytics, FortiGate can be used with FortiManager and FortiAnalyzer.",
            "provider_name": "Fortinet Inc.",
            "offering_docs_url": "https://cloud.ibm.com/docs/licensed-firewall",
            "offering_icon_url": "https://fortinet.s3.us.cloud-object-storage.appdomain.cloud/Fortinet.png",
            "features": [
                {
                    "title": "NGFW protection",
                    "description": "L4-L7 visibility and protection for ingress/egress traffic"
                },
                {
                    "title": "Intent-based Segmentation",
                    "description": "Inspect and isolate inter-subnet traffic in same VPC and inter-VPC traffic"
                },
                {
                    "title": "High Availability",
                    "description": "Meet Service level availability and performance requirements with Active-Passive High availability pairs deployed in virtual networks."
                }
            ],
